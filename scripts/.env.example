# TerraCare ESP32 Simulator — copy to .env and fill in values
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_KEY=your-service-role-key-here

# UUID of the logged-in test user (profiles.id / auth.users.id)
TEST_USER_ID=00000000-0000-0000-0000-000000000000

# Optional overrides
TEST_DEVICE_MAC=AA:BB:CC:DD:EE:01
TEST_DEVICE_NAME=Simulator-ESP32
